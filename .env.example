# 复制为 .env 后按需填写：`set -a && source .env && set +a`

# ---------- 预训练 / Few-shot 共用：DINOv3 ----------
# 可选。不设则默认使用仓库内 weights/dinov3-vitl16-pretrain-lvd1689m（见 weights/README.txt）
# FLEET_DINOV3_MODEL_PATH=/path/to/dinov3-vitl16-pretrain-lvd1689m

# ---------- 预训练（fleet-pretrain / python -m fleet.train.dual_branch_q128）----------
FLEET_AIGIBENCH_TRAIN=/path/to/AIGIBench/train
FLEET_AIGIBENCH_VAL=/path/to/AIGIBench/val
# 可选：checkpoint 输出目录（默认 ./outputs/checkpoints）
# FLEET_CHECKPOINT_DIR=/path/to/checkpoints
# 可选：训练过程中 few-shot 风格验证集（不设则跳过对应评测）
# FLEET_FEWSHOT_FAKE_DIR=/path/to/fewshot/final/fake
# FLEET_FEWSHOT_REAL_DIR=/path/to/fewshot/final/real

# ---------- Few-shot（fleet-fewshot / python -m fleet.train.fewshot_experiment）----------
# FLEET_PRETRAIN_CHECKPOINT=/path/to/pretrain_*.pth
# FLEET_PROTOTYPE_DIR=/path/to/prototypes_dir
# FLEET_REAL_SUPPORT_DIR=/path/to/real/support/pool
# FLEET_REAL_VAL_DIR=/path/to/real/val
# FLEET_OTHER_FAKE_BASE_DIR=/path/to/fake/subsets/parent
